# Database URL (SQLAlchemy). Defaults to sqlite:///./recipes.db if not provided.
# Examples:
# DB_URL=sqlite:///./recipes.db
# DB_URL=postgresql+psycopg2://user:pass@host:5432/dbname
DB_URL=sqlite:///./recipes.db

# CORS: Allowed frontend origin. The backend always allows http://localhost:3000 for local dev.
# Set this to your deployed frontend origin in production.
FRONTEND_ORIGIN=http://localhost:3000

# Seed demo data on startup if database is empty (true/false)
SEED_ON_START=false
